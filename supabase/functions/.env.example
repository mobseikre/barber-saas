# Copy to supabase/functions/.env (git-ignored) for the local stack.
# Production values are set with `supabase secrets set`, never committed.

# Must match the Vault secret `notification_webhook_secret` (seed.sql sets the local one).
NOTIFICATION_WEBHOOK_SECRET=local-notification-secret

# The Firebase service account key JSON on one line. Without it the function answers 503.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Only for tests against a fake FCM server.
# FCM_API_URL=http://host.docker.internal:9911

# admin-reset-password: browser origins of the admin panel allowed to call it (comma separated).
# Defaults to http://localhost:3000,http://127.0.0.1:3000. In production set it with `supabase secrets set`.
# ADMIN_ALLOWED_ORIGINS=https://admin.example.com
